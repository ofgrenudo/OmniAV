DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=omniav
DB_PORT=5432
DB_SSLMODE=disable

# OAuth (goth). Callback URLs to register with each provider:
#   {AUTH_BASE_URL}/api/auth/google/callback
#   {AUTH_BASE_URL}/api/auth/azure/callback
AUTH_BASE_URL=https://localhost
AUTH_FRONTEND_URL=https://localhost
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
AUTH_SECURE_COOKIES=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common

# TLS for the proxy. By default a self-signed cert is generated on first start and kept in a volume.
# For a real certificate, point TLS_CERT_DIR at a host directory and set the filenames, e.g.:
#   TLS_CERT_DIR=/etc/letsencrypt/live/example.com
#   TLS_CERT_FILE=fullchain.pem
#   TLS_KEY_FILE=privkey.pem
#   TLS_SERVER_NAME=example.com
TLS_CERT_DIR=proxy_certs
TLS_CERT_FILE=tls.crt
TLS_KEY_FILE=tls.key
TLS_SERVER_NAME=localhost
